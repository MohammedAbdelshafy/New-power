# MBM Hunter — environment (copy to .env; never commit real keys).
# The core pipeline needs NONE of these. They unlock optional backends.

# Force a specific chromium binary for Playwright (web sessions set this already):
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# LLM key for Tier-2 agentic navigation (browser-use / stagehand), when adopted:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
